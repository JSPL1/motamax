# Copy to .env for local runs, or set these as environment variables on your host.
PORT=5510
NODE_ENV=production
# Long random string — signs logins and encrypts the stored SMTP/IMAP passwords. Required in production.
SESSION_SECRET=change-me-to-a-long-random-string
# Postgres connection string (recommended in production so enquiries persist). Leave empty to use data/db.json.
DATABASE_URL=
# Admin account created automatically at start-up if it doesn't exist yet (never overwritten).
# Set ADMIN_USERNAME and/or ADMIN_EMAIL, plus ADMIN_PASSWORD.
ADMIN_NAME=Administrator
ADMIN_USERNAME=admin
ADMIN_EMAIL=
ADMIN_PASSWORD=choose-a-strong-password
